# Documentation only: PHP does NOT automatically load this file.
# Configure environment variables in Apache/hosting, outside the repository.
GOOGLE_MAPS_BROWSER_KEY=YOUR_HTTP_REFERRER_RESTRICTED_BROWSER_KEY
GOOGLE_PLACES_API_KEY=YOUR_SERVER_IP_RESTRICTED_PLACES_KEY
# Optional for development; create a production map ID before deploying.
GOOGLE_MAPS_MAP_ID=YOUR_MAP_ID
